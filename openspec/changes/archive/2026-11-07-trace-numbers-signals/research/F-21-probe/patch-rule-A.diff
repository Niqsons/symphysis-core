+def _record_refs(text: str, own: str | None = None) -> list[tuple[int, str | None, str | None]]:
+    """Проба F-21, правило A: ссылки `(номер, буква варианта или None, имя журнала или None)`; имя — из ближайшей слева
+    метки ``журнал `имя`:`` той же строки до `;`, `)` или конца строки; имя, равное `own`, — своё (None)."""
+    scopes = []
+    for m in _JOURNAL_LABEL.finditer(text):
+        end = _LIST_END.search(text, m.end())
+        scopes.append((m.end(), end.start() if end else len(text), m.group(1)))
+    out = []
+    for m in _REC_REF.finditer(text):
+        journal = next((name for start, stop, name in scopes if start <= m.start() < stop), None)
+        out.append((int(m.group(1)), m.group(2), None if journal == own else journal))
+    return out
